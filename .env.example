# Copy this file to .env and fill in what you need. Everything is optional.

# --- AI (needed for command suggestions and troubleshooting) ---
# Any OpenAI-compatible endpoint works.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# Azure OpenAI only: sent as ?api-version=
# OPENAI_API_VERSION=2024-08-01-preview
# Extra headers as JSON, e.g. for an API gateway:
# OPENAI_EXTRA_HEADERS={"my-gateway-key": "value"}

# --- Server ---
# PORT=8080
# HOST=127.0.0.1
# Change this if anyone else can reach the server:
# APP_SECRET=replace-with-a-long-random-string

# --- Terminal ---
# Set to false to disable guest mode (the local terminal):
# OPSPILOT_LOCAL_TERMINAL=false
